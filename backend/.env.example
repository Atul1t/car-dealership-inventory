# Copy to .env and adjust as needed.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dealership
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Used by `python -m app.scripts.seed` to bootstrap an admin account.
ADMIN_EMAIL=admin@dealership.com
ADMIN_PASSWORD=Admin@12345
